{
  "expo": {
    "name": "pic-to-playlist",
    "slug": "pic-to-playlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/skull-bgw.png",
      "resizeMode": "contain",
      "backgroundColor": "#212121"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kevintruong.pictoplaylist",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "android.kevintruong.pictoplaylist"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "name": "Pic to Playlist",
      "description": "Turn an image into visual features and a Spotify playlist.",
      "themeColor": "#101010"
    },
    "experiments": {
      "baseUrl": "/pic-to-playlist"
    }
  }
}
